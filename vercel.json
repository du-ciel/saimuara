{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.9.0"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "Saimuara",
        "APP_ENV": "production",
        "APP_KEY": "base64:89c3BSh9PeWKOc42TRIudJNLXfNO62xHLzuUXPxY9HE=",
        "APP_DEBUG": "false",
        "APP_TIMEZONE": "Asia/Jakarta",
        "APP_URL": "https://saimuara.vercel.app",
        "APP_LOCALE": "en",
        "APP_FALLBACK_LOCALE": "en",
        "BCRYPT_ROUNDS": "12",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "error",
        "DB_CONNECTION": "mysql",
        "DB_HOST": "gateway01.ap-southeast-1.prod.aws.tidbcloud.com",
        "DB_PORT": "4000",
        "DB_DATABASE": "saimuara",
        "DB_USERNAME": "2cu2Pa35UmFxX2m.root",
        "DB_PASSWORD": "rZ1E2NlZv0mCbiAt",
        "SESSION_DRIVER": "cookie",
        "SESSION_LIFETIME": "120",
        "CACHE_STORE": "array",
        "QUEUE_CONNECTION": "sync",
        "FILESYSTEM_DISK": "local",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php"
    }
}
